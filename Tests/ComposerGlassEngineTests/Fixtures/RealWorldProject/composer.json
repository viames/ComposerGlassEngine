{
  "name": "composerglass/fixture-project",
  "description": "A realistic Composer project fixture for native-engine integration tests.",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": "^8.2",
    "psr/log": "^3.0",
    "symfony/console": "^7.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0"
  },
  "autoload": {
    "psr-4": {
      "ComposerGlass\\Fixture\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "ComposerGlass\\Fixture\\Tests\\": "tests/"
    }
  },
  "config": {
    "allow-plugins": false,
    "platform": {
      "php": "8.4.1"
    },
    "sort-packages": true
  },
  "prefer-stable": true
}
